<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_car_bringup</name>
  <version>0.0.1</version>
  <description>
    Bringup / launch package for the Keyestudio 4WD robot car.
    Launches the motor driver and web server nodes together so the
    whole robot can be started from a single systemd service.
  </description>
  <maintainer email="nersis.oliren@gmail.com">Oliren</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>robot_car_driver</exec_depend>
  <exec_depend>robot_car_web</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
